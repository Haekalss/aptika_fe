# URL backend API yang dipakai aplikasi (dipakai saat hostname bukan localhost).
# Untuk pengembangan lokal, ketik http://localhost:8000/api jika backend dijalankan lokal.
NEXT_PUBLIC_API_URL=https://aptika-be.wasmer.dev/api

# (Opsional) Override URL backend khusus untuk hostname localhost; default http://localhost:8000/api.
# NEXT_PUBLIC_API_URL_LOCAL=http://localhost:8000/api

# (Opsional, pengembangan FE tanpa backend) Mode mock modul FR-048 — setel "true" untuk preview UI dengan data dummy.
# Data hilang saat refresh penuh dan endpoint backend TIDAK dipanggil.
# NEXT_PUBLIC_FR048_MOCK_API=true
